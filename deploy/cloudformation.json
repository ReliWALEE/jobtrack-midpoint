{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "JobTrack private midpoint demo. No inbound network ports. SSM tunnel required.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "Public subnet with an Internet gateway route for outbound bootstrap/SSM"
    },
    "SourceBucket": {
      "Type": "String",
      "Description": "Private S3 bucket containing source ZIP"
    },
    "SourceKey": {
      "Type": "String",
      "Default": "jobtrack/JobTrack-source.zip"
    },
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.micro",
      "AllowedValues": [
        "t3.micro",
        "t3.small"
      ]
    }
  },
  "Resources": {
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          }
        ],
        "Policies": [
          {
            "PolicyName": "ReadJobTrackSource",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${SourceBucket}/${SourceKey}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Profile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "Role"
          }
        ]
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "No ingress. Use SSM port forwarding.",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "Instance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "IamInstanceProfile": {
          "Ref": "Profile"
        },
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "SubnetId"
            },
            "GroupSet": [
              {
                "Ref": "SecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 12,
              "VolumeType": "gp3",
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": "#!/bin/bash\nset -euxo pipefail\ndnf install -y python3 unzip awscli-2\nmkdir -p /opt/jobtrack /var/lib/jobtrack\naws s3 cp s3://${SourceBucket}/${SourceKey} /tmp/jobtrack.zip --region ${AWS::Region}\nunzip /tmp/jobtrack.zip -d /opt/jobtrack\nuseradd --system jobtrack\nchown jobtrack:jobtrack /var/lib/jobtrack\ncat > /etc/systemd/system/jobtrack.service <<'UNIT'\n[Unit]\nDescription=JobTrack midpoint\nAfter=network.target\n[Service]\nUser=jobtrack\nWorkingDirectory=/opt/jobtrack/JobTrack\nEnvironment=JOBTRACK_DB=/var/lib/jobtrack/jobtrack.sqlite3\nExecStart=/usr/bin/python3 server.py --host 127.0.0.1 --port 8000\nRestart=on-failure\nNoNewPrivileges=true\nProtectSystem=strict\nReadWritePaths=/var/lib/jobtrack\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now jobtrack\n"
          }
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "JobTrack-midpoint"
          }
        ]
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Instance"
      }
    },
    "Access": {
      "Value": "Use SSM port forwarding: remote 8000 to local 8000. No public website URL."
    }
  }
}
