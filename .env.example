# Optional: enables broad job search, including Indeed and LinkedIn via JSearch.
# By default every server run rotates its own free-credit OpenWeb Ninja account
# automatically. A manual key is used only with JOBTRACK_AUTO_ACCOUNT=0.
# Automatic mode waits for this run's new key and reports setup failures.
# Get your own key at https://app.openwebninja.com . Copy this template to .env
# beside server.py. Only the variables below are read.
# An environment variable takes precedence, including an explicit empty value.
JSEARCH_API_KEY=

# Set to 0/false/no to disable per-run account rotation and rely purely on the
# manual key above. Defaults to enabled when unset.
JOBTRACK_AUTO_ACCOUNT=1
